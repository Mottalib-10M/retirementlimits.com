---
import PageLayout from '../../layouts/PageLayout.astro';
import LegalIdentity from '../../components/LegalIdentity.astro';
import { CONTACT_EMAIL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { contactPageSchema } from '../../lib/seo';
const lang = 'en';
const path = route('contact', lang);
const description = 'Write to the publisher of Retirement Limits about a limit, a rule or a source on the contribution and RMD calculators. E-mail only, no advice on your own case, nothing sold.';
---
<PageLayout title="Contact Retirement Limits: corrections to a limit, a rule or a source" description={description} lang={lang} noindex={true} jsonLd={[contactPageSchema({ name: 'Contact', description, path, lang })]} breadcrumbs={[{ label: 'Contact' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none prose-headings:font-serif">
    <h1>Contact</h1>
    <p>By e-mail: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. No form and no newsletter: we sell no account and need no address.</p>
    <h2>Messages that help</h2>
    <ul>
      <li>A limit or rule that differs from the IRS notice, revenue procedure or publication we cite: name the page and the paragraph of the official text.</li>
      <li>A new IRS release, such as the 2027 cost-of-living notice, that we have not added yet.</li>
      <li>A case the calculators handle badly, with the figures you typed.</li>
      <li>Embedding the calculator on a blog, an intranet or a course page: the code is on the <a href={route('widget', lang)}>embed page</a>.</li>
    </ul>
    <h2>What we cannot do</h2>
    <p>We do not review personal situations or recommend investments. For your plan, ask its administrator; for your return, a tax professional or the IRS.</p>
    <h2>Publisher</h2>
    <LegalIdentity lang={lang} />
  </div>
</PageLayout>
