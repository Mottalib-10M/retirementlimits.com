---
/**
 * Home, in its own order: the all-limits calculator first, then the three-year ledger (2025, 2026, 2027),
 * the folded answer, why the headline is rarely your limit, the 2027 note, the page index as a table
 * by account family, long text in accordions, FAQ. Text: src/content/home.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import { HOME } from '../content/home';
import { route } from '../i18n/routes';
import { GROUPS } from '../i18n/nav';
import { helpers, SOURCES } from '../lib/helpers';
import { GUIDES } from '../lib/pages';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
const lang = 'en';
const x = HOME;
const path = route('home', lang);
const h = helpers();
const sources = x.sources.map((k) => ({ name: SOURCES[k].label, url: SOURCES[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(x.faqs, lang)];
const rows = x.ledger();
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} sources={sources}>
  <header class="mb-4 border-l-4 border-accent-600 pl-4">
    <h1 class="font-serif text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    <p class="mt-2 text-base text-navy-700 sm:text-lg">{x.intro}</p>
    <p class="mt-1 text-sm text-navy-600">Every amount read on irs.gov · <a href={route('method', lang)} class="underline">How each limit is computed</a> · <a href={route('about', lang)} class="underline">Who publishes this</a></p>
  </header>
  <div data-outil data-chrome><Tool kind="all" idPrefix="home" /></div>
  <Clamp text={x.resume} lang={lang} id="clamp-home" class="my-8" />
  <section class="my-8" data-chrome>
    <h2 class="font-serif text-2xl font-bold text-navy-900">The ledger: 2025, 2026 and 2027 side by side</h2>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full border-collapse text-sm">
        <thead><tr class="border-b-2 border-navy-300 text-left"><th class="py-2 pr-3">Limit</th><th class="py-2 pr-3 text-right">2025</th><th class="py-2 pr-3 text-right">2026</th><th class="py-2 text-right">2027</th></tr></thead>
        <tbody>{rows.map((r) => <tr class="border-b border-navy-100"><td class="py-2 pr-3">{r[0]}</td><td class="py-2 pr-3 text-right tabular-nums text-navy-600">{r[1]}</td><td class="py-2 pr-3 text-right font-semibold tabular-nums">{r[2]}</td><td class="py-2 text-right tabular-nums text-navy-600">{r[3].startsWith("$") ? r[3] : <span class="italic">{`due ${r[3]}`}</span>}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="mt-2 text-xs text-navy-600">{x.ledgerCaption}</p>
  </section>
  <section class="prose prose-slate max-w-none prose-headings:font-serif"><Fragment set:html={x.why(h)} /></section>
  <aside class="boxnote my-8"><p class="boxnote-title">2027 limits</p><div class="text-navy-800"><Fragment set:html={x.next(h)} /></div></aside>
  <section class="mt-10" data-chrome>
    <h2 class="font-serif text-2xl font-bold text-navy-900">One page per limit</h2>
    <div class="mt-4 grid gap-6 md:grid-cols-2">
      {GROUPS.map((g) => (
        <div>
          <h3 class="border-b border-navy-200 pb-1 text-sm font-semibold uppercase tracking-wide text-navy-700">{g.label}</h3>
          <ul class="mt-2 divide-y divide-navy-100 text-sm">
            {GUIDES.filter((p) => p.group === g.id).map((p) => <li class="py-1.5"><a href={route(p.id, lang)} class="font-medium text-accent-700 underline-offset-2 hover:underline">{p.nav}</a> <span class="text-navy-600">· {p.card}</span></li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>
  <section class="mt-10">
    <h2 class="font-serif text-2xl font-bold text-navy-900">Rules that change the number</h2>
    {x.sections(h).map((s) => <details class="fold"><summary><h3 class="fold-h">{s.title}</h3></summary><div class="prose prose-slate max-w-none pb-4"><Fragment set:html={s.html} /></div></details>)}
  </section>
</PageLayout>
